# Copy to .env and adjust for your environment.
# See docs/DEPLOY.md for the Railway (API) and Vercel (web) variable tables.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ecoguard:change-me@localhost:5432/ecoguard
# Browser origins allowed to call the API with cookies. In production this is the
# Vercel URL. ALLOWED_ORIGINS is still accepted as an alias.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
SESSION_COOKIE=ecoguard_session
COOKIE_SECURE=false
SESSION_SAMESITE=lax
SESSION_HOURS=12
JOBS_MODE=inline
# Set true to allow JOBS_MODE=inline while APP_ENV=production (single service, no worker).
ALLOW_INLINE_JOBS=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=15
STORAGE_BACKEND=local
MEDIA_DIR=./var/media
MAX_UPLOAD_MB=10
IMAGE_ASSISTANCE=auto
SPECIESNET_MODEL=kaggle:google/speciesnet/pyTorch/v4.0.3b/1
SPECIESNET_CACHE_DIR=./var/models
SPECIESNET_DEVICE=cpu
SPECIESNET_WARMUP=true
CONFIDENCE_THRESHOLD=0.75
SMS_PROVIDER=disabled
ENABLE_API_DOCS=true
AUTO_CREATE_TABLES=true
DEMO_ENABLED=false

# --- Container entrypoint (scripts/start.sh) ---
# true runs `alembic upgrade head` before the app serves traffic.
RUN_MIGRATIONS_ON_START=false
# Hosts whose X-Forwarded-For is trusted. "*" is correct behind a platform proxy.
FORWARDED_ALLOW_IPS=*
# Optional: run a Celery worker next to the API (jobs_mode=celery).
#   celery -A app.worker.celery_app worker --loglevel=info
